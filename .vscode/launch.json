{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Program",
      "program": "${workspaceFolder}/app.js",
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
    {
      "name": "Java: Run Java",
      "type": "java",
      "request": "launch",
      "mainClass": "Java",
      "projectName": "",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Hello World",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Hello-World-Projekt.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
