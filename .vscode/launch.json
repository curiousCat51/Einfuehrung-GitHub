{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Program",
      "program": "${workspaceFolder}/app.js",
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
    {
      "name": "Launch Startprojekt JavaScript",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/Startprojekt JavaScript.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch Startprojekt TypeScript (ts-node)",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "tsc: build Startprojekt TypeScript",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node"],
      "args": ["${workspaceFolder}/Startprojekt TypeScript.ts"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Java: Run Java",
      "type": "java",
      "request": "launch",
      "mainClass": "Java",
      "projectName": "",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Hello World",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Hello-World-Projekt.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
